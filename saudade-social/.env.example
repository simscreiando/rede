# Copie este arquivo para .env e preencha com os valores do SEU projeto.
# NUNCA commite o .env real — o .gitignore já bloqueia isso.

# URL pública canônica desta implantação (sem barra no final).
# Usada em: redirectTo do OAuth, canonical, sitemap, metadata.
# Local:      http://localhost:3000
# Preview:    https://<preview>.vercel.app
# Produção:   https://<dominio-definitivo>
VITE_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase: valores públicos (expostos ao navegador, é esperado) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Cópia sem prefixo VITE_, usada em código server-side.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Supabase: segredo — SÓ no ambiente de servidor (Vercel), NUNCA no navegador ---
# Usada apenas em src/integrations/supabase/client.server.ts e em server
# functions que precisam de privilégio administrativo (ex.: exclusão de
# conta na Fase 7). Configure como variável de ambiente "server-only" na
# Vercel — nunca com prefixo VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth ---
# Não há variável de app para isso: o provedor Google é habilitado e
# configurado (client id/secret) diretamente no painel do Supabase
# (Authentication > Providers > Google). O app só precisa saber o
# VITE_PUBLIC_APP_URL acima para montar a redirectTo corretamente.
